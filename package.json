{
  "name": "eduda",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "ts:check": "turbo ts:check",
    "check": "node scripts/check-tokens.mjs && turbo check",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:fix": "turbo check:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2"
  }
}
