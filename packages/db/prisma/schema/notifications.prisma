/// Привязка аккаунта мессенджера к родителю.
///
/// У одного человека здесь бывает несколько строк: дети в разных школах — это
/// разные `Parent`, и телефон, названный боту один раз, привязывается ко всем
/// совпавшим. Отсюда `parentId` в уникальном ключе, а не пара
/// `provider + externalId`. `ownBot` там же: один и тот же аккаунт бывает
/// подключён и к боту ЕДУДА, и к собственному боту школы.
model ParentMessenger {
    id       Int               @id @default(autoincrement())
    provider MessengerProvider
    /// user_id в мессенджере. Строкой: идентификаторы чужие, арифметики над ними
    /// нет.
    externalId String
    /// Верифицированный номер из `request_contact`. Нужен, чтобы потом было
    /// видно, по какому номеру привязались.
    phone     String?
    createdAt DateTime @default(now())
    /// Отписка не удаляет строку: иначе повторная привязка выглядит как первая,
    /// и на «почему мне перестало приходить» ответить нечем.
    unsubscribedAt DateTime?
    /// Через какой бот привязан: `false` — бот ЕДУДА, `true` — собственный бот
    /// школы `organizationId`. Напоминания идут только через бот, которым школа
    /// рассылает сейчас (`@repo/core/messenger`); привязки другого бота остаются
    /// и снова работают, когда школа к нему вернётся.
    ownBot         Boolean   @default(false)

    // Relations
    organizationId Int
    parentId       Int
    organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    parent         Parent               @relation(fields: [parentId], references: [id], onDelete: Cascade)
    outbox         NotificationOutbox[]

    @@unique([provider, externalId, parentId, ownBot])
    @@index([provider, externalId])
    @@index([parentId])
    @@index([organizationId])
}

/// Очередь исходящих уведомлений: планировщик пишет, дренаж отправляет.
model NotificationOutbox {
    id Int @id @default(autoincrement())
    /// Пока единственный вид — `LESSON_REMINDER`. Строкой, а не enum'ом: новый
    /// вид не должен требовать миграции, а читателей у поля нет кроме логов.
    kind String
    /// `lesson-reminder:<parentMessengerId>:<YYYY-MM-DD>`. `@unique` заменяет
    /// планировщику состояние «когда я запускался в прошлый раз»: крон может
    /// приходить хоть каждые десять минут, вторая строка не заведётся.
    dedupeKey String @unique
    /// Готовый текст — снимок расписания на момент планирования.
    text     String
    status   NotificationStatus @default(PENDING)
    attempts Int                @default(0)
    /// Когда пробовать снова. У свежей строки — сейчас, дальше двигает backoff.
    /// Перед отправкой дренаж сдвигает его вперёд — это бронь от соседнего прохода.
    nextAttemptAt DateTime  @default(now())
    lastError     String?
    sentAt        DateTime?
    createdAt     DateTime  @default(now())

    // Relations
    organizationId    Int
    parentMessengerId Int
    organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    parentMessenger   ParentMessenger @relation(fields: [parentMessengerId], references: [id], onDelete: Cascade)

    @@index([status, nextAttemptAt])
    @@index([organizationId])
}

/// Собственный бот MAX школы. Строки нет — напоминания идут ботом ЕДУДА.
///
/// Отдельной таблицей, а не колонками `Organization`: сессия сотрудника несёт
/// строку организации целиком (`customSession`), и токен уехал бы в браузер.
model OrganizationMaxBot {
    organizationId Int      @id
    /// Токен бота: AES-256-GCM ключом `MAX_BOT_TOKEN_KEY` (`@repo/core/secret-box`).
    tokenEnc       Bytes
    /// Публичное имя бота из `GET /me` — для ссылки `max.ru/<username>`.
    username       String
    createdAt      DateTime @default(now())

    // Relations
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
