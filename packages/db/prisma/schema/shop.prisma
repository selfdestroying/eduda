// Shop related models. They are currently quite basic, but they can be expanded in the future with more features like discounts, product variants, etc.
model Cart {
    id             Int          @id @default(autoincrement())
    organizationId Int          @default(1)
    studentId      Int          @unique
    createdAt      DateTime     @default(now())
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    Student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
    CartItem       CartItem[]

    @@index([organizationId])
}

model CartItem {
    id             Int          @id @default(autoincrement())
    organizationId Int          @default(1)
    cartId         Int
    productId      Int
    quantity       Int
    createdAt      DateTime     @default(now())
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    Cart           Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
    Product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@unique([cartId, productId])
    @@index([cartId])
    @@index([productId])
}

model Category {
    id             Int    @id @default(autoincrement())
    organizationId Int
    name           String

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    Product      Product[]

    @@index([organizationId])
}

model Product {
    id             Int        @id @default(autoincrement())
    organizationId Int        @default(1)
    name           String
    description    String?
    price          Int
    originalPrice  Int?
    imageUrl       String
    categoryId     Int
    rating         Float      @default(0)
    reviews        Int        @default(0)
    popular        Boolean    @default(false)
    quantity       Int
    cartItem       CartItem[]
    order          Order[]

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@index([categoryId])
    @@index([organizationId])
}

/// История изменений баланса астрокоинов — по образцу StudentLessonsBalanceHistory.
/// `StudentAccount.coins` остаётся денормализованным кешем, а инвариант такой:
/// сумма `amount` по ученику равна его `coins`.
///
/// Пишут оба приложения: платформа (начисления, ручные правки, отмена заказа) и
/// шоп (покупка). Каждая запись обязана лежать в той же транзакции, что и
/// изменение `coins`, иначе инвариант разъедется.
model CoinTransaction {
    id             Int          @id @default(autoincrement())
    organizationId Int
    studentId      Int
    amount         Int
    reason         CoinTxReason
    /// Ссылки на источник — намеренно БЕЗ внешних ключей: леджер обязан пережить
    /// удаление заказа или записи посещаемости. Тот же приём, что `meta` у
    /// StudentLessonsBalanceHistory.
    orderId        Int?
    attendanceId   Int?
    createdAt      DateTime     @default(now())

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@index([studentId, createdAt])
    @@index([organizationId])
}

model Order {
    id             Int          @id @default(autoincrement())
    organizationId Int          @default(1)
    productId      Int
    studentId      Int
    quantity       Int          @default(1)
    status         OrderStatus  @default(PENDING)
    createdAt      DateTime     @default(now())
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
    student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@index([productId])
    @@index([studentId])
    @@index([organizationId])
}
