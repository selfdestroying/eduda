model PayCheck {
    id        Int          @id @default(autoincrement())
    amount    Int
    comment   String
    date      String
    type      PayCheckType @default(SALARY)
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    // Relations
    organizationId Int
    userId         Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user           User         @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([organizationId])
}

model ManagerSalary {
    id            Int       @id @default(autoincrement())
    monthlyAmount Int
    startDate     String
    endDate       String?
    comment       String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // Relations
    organizationId Int
    userId         Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([organizationId])
}

model Rate {
    id              Int      @id @default(autoincrement())
    name            String
    bid             Int
    bonusPerStudent Int      @default(0)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    // Relations
    organizationId Int
    organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    teacherGroups  TeacherGroup[]
    groupTypes     GroupType[]

    @@index([organizationId])
}

model Payment {
    id           Int      @id @default(autoincrement())
    lessonCount  Int      @default(0)
    price        Int      @default(0)
    bidForLesson Int      @default(0)
    leadName     String   @default("")
    productName  String   @default("")
    date         String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    /// Отменённая оплата не удаляется: на неё ссылаются проводки уже проведённых
    /// занятий, и стереть её значило бы переписать выручку прошлых месяцев. Такой
    /// пакет выбывает из очереди, а его непотраченный остаток снимается с баланса.
    status PaymentStatus @default(ACTIVE)
    /// Когда отменили — чтобы в списке было видно, что это не свежая запись.
    cancelledAt DateTime?

    /// Сколько уроков пакета ещё не потрачено. Пакеты кошелька образуют очередь по
    /// `date`: посещение гасит головной пакет с `remaining > 0` и забирает его цену.
    /// null — пакет не размечен (оплаты до бэкфилла), в очередь такой не встаёт.
    remaining Int?

    /// Не оплата, а корректировка: пакеты, которыми бэкфилл свёл остатки кошельков с
    /// их балансом. За ними стоят ручные операции старой системы — правки баланса,
    /// переносы между кошельками, — платежа под ними нет. В очередь такой пакет
    /// встаёт наравне с остальными, иначе списывать эти уроки было бы не с чего, но
    /// в суммах поступлений он отделён, а из раздачи истории исключается: пусти его
    /// туда — прошлые визиты его съедят, и следующий прогон заведёт ещё одну порцию.
    isAdjustment Boolean @default(false)

    // Relations
    organizationId  Int
    studentId       Int
    groupId         Int?
    walletId        Int?
    paymentMethodId Int?
    /// Кто продал. Не автор записи: оплаты часто вносит один администратор за всех,
    /// а премия причитается тому, кто договорился. Поле необязательное — у оплат до
    /// его появления менеджера нет, и расчёты это переживают.
    managerId       Int?
    organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    student         Student        @relation(fields: [studentId], references: [id])
    group           Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
    wallet          Wallet?        @relation(fields: [walletId], references: [id], onDelete: SetNull)
    paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
    manager         User?          @relation(fields: [managerId], references: [id], onDelete: SetNull)

    attendances Attendance[]

    @@index([studentId])
    @@index([organizationId])
    @@index([createdAt])
    @@index([groupId])
    @@index([walletId])
    @@index([paymentMethodId])
    @@index([walletId, date])
    @@index([managerId])
}

model UnprocessedPayment {
    id        Int      @id @default(autoincrement())
    rawData   Json?
    reason    String
    resolved  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    organizationId Int
    studentId      Int?
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    student        Student?     @relation(fields: [studentId], references: [id])

    @@index([organizationId])
    @@index([studentId])
}

model PaymentProduct {
    id          Int    @id @default(autoincrement())
    name        String
    productId   Int?
    price       Int
    lessonCount Int

    // Relations
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
}

model PaymentMethod {
    id          Int      @id @default(autoincrement())
    name        String
    commission  Float    @default(0)
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    payments       Payment[]

    @@index([organizationId])
}

model TaxConfig {
    id        Int      @id @default(autoincrement())
    taxSystem String // "USN_INCOME", "OSNO", etc.
    config    Json // System-specific parameters, validated by Zod at app level
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizationId Int          @unique
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
}

model StudentLessonsBalanceHistory {
    id             Int                               @id @default(autoincrement())
    studentId      Int
    organizationId Int
    actorUserId    Int?
    groupId        Int?
    walletId       Int?
    field          StudentFinancialField             @default(LESSONS_BALANCE)
    reason         StudentLessonsBalanceChangeReason
    delta          Int
    balanceBefore  Int
    balanceAfter   Int
    comment        String?
    meta           Json?
    createdAt      DateTime                          @default(now())
    updatedAt      DateTime                          @updatedAt

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
    actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
    group        Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
    wallet       Wallet?      @relation(fields: [walletId], references: [id], onDelete: SetNull)

    @@index([studentId, createdAt])
    @@index([actorUserId, createdAt])
    @@index([organizationId])
    @@index([groupId])
    @@index([walletId])
}

model Expense {
    id        Int      @id @default(autoincrement())
    name      String
    amount    Int
    date      String
    comment   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    organizationId Int
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
}
