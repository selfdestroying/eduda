# Личный кабинет ученика. Единый домен shop.{rootDomain} — без поддомена школы,
# организация приходит из сессии.

# Auth — СВОЙ инстанс better-auth, куки не шарятся с платформой (cookiePrefix edu_student).
BETTER_AUTH_SECRET="supersecretkey"
BETTER_AUTH_URL="http://localhost:3002"

# Корневой домен — только чтобы Next в dev не считал shop.{rootDomain}
# кросс-доменным (allowedDevOrigins). Организация берётся из сессии, не из хоста.
NEXT_PUBLIC_ROOT_DOMAIN="eduda.test:3000"

# Database — та же БД, что у платформы (@repo/db)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres?schema=public"

# Server
PORT=3002
TZ=UTC
