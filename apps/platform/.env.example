# Auth
BETTER_AUTH_SECRET="supersecretkey"
BETTER_AUTH_URL='http://.test:3000'
# Ключ шифрования паролей учеников (AES-256-GCM): 32 байта в base64.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Без него не создать ученика и не показать его пароль; вход ученика в шоп идёт
# по хешу и от этого ключа не зависит.
STUDENT_PW_KEY=""

# Frontend
NEXT_PUBLIC_ROOT_DOMAIN="dashboard.test:3000"
# Документация — отдельное приложение (apps/docs). В проде переменная не нужна:
# дефолт `docs.{NEXT_PUBLIC_ROOT_DOMAIN}` резолвится DNS прямо в него.
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Database
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres?schema=public"

# Server
PORT=3000
TZ=UTC

# Image
IMAGE_URL="http://localhost:3000"
IMAGE_PATH="/uploads"

# AI Assistant (OpenRouter)
OPENROUTER_API_KEY=""
ASSISTANT_MODEL="openai/gpt-4o-mini"

# Demo mode
# DEMO_ENABLED="false" — полностью выключить вход в демо (по умолчанию включён)
DEMO_ENABLED="true"
# Пароли demo-пользователей (демо публичное, значения условны)
DEMO_OWNER_PASSWORD="demo1234"
DEMO_MANAGER_PASSWORD="demo1234"
DEMO_TEACHER_PASSWORD="demo1234"

# amoCRM (опрос оплат)
# Аккаунт один на школу, токен долгоживущий. Без этих двух переменных опрос
# не работает; всё остальное приложение — работает.
AMOCRM_SUBDOMAIN=""
AMOCRM_TOKEN=""
# Ключ роута /api/amocrm/poll: nginx проксирует `/` целиком, поэтому ручка
# видна снаружи. Пустой ключ = роут отвечает 401 всем.
AMOCRM_POLL_KEY=""
# Школа, чьи оплаты забирает опрос: аккаунт CRM один на установку, значит и
# школа одна. Без неё роут опроса отвечает 502.
AMOCRM_ORGANIZATION_ID=""
