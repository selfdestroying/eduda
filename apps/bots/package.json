{
  "name": "bots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts:check": "tsc --noEmit",
    "check": "(npm run format:check || npm run format) && npm run ts:check",
    "check:bind": "tsx --env-file=.env scripts/check-bind.ts"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "prettier": "3.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
