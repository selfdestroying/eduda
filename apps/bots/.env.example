# Та же база, что у платформы: боты пишут привязки и очередь в неё.
DATABASE_URL="postgresql://user:password@localhost:5432/alg?schema=public"

# Прод — 3006 (3001..3005 заняты), локально — 3003.
PORT=3006

# Сообщество ЕДУДА: ключ доступа с правом «Сообщения сообщества».
VK_GROUP_TOKEN=
# Короткое имя сообщества — из него собирается ссылка vk.me/<...>?ref=<токен>.
VK_GROUP_SCREEN_NAME=
# Настройки сообщества → Работа с API → Callback API.
VK_CONFIRMATION=
VK_SECRET=
