# Та же база, что у платформы: боты пишут привязки и очередь в неё.
DATABASE_URL="postgresql://user:password@localhost:5432/alg?schema=public"

# Прод — 3006 (3001..3005 заняты), локально — 3003.
PORT=3006

# Заголовок X-Notify-Key для /dispatch — его знает только системный cron.
NOTIFY_KEY=

# Адрес платформы — только для ссылки на кабинет родителя в ответах бота.
# Не задан — берётся https://eduda.online.
PLATFORM_URL=https://eduda.online

# Бот ЕДУДА. Публикация бота в MAX требует верифицированного юрлица РФ, поэтому
# токен необязателен: без него работают только боты школ.
MAX_BOT_TOKEN=
# Вебхук бота ЕДУДА. Бот школы получает события на тот же адрес с
# /<organizationId> на конце, секрет его выводится из MAX_WEBHOOK_SECRET.
MAX_WEBHOOK_URL=https://bots.eduda.online/max
MAX_WEBHOOK_SECRET=

# Ключ расшифровки токенов ботов школ — тот же, что MAX_BOT_TOKEN_KEY платформы.
# 32 байта в base64. Нужен, только когда у какой-нибудь школы есть свой бот.
MAX_BOT_TOKEN_KEY=
