# Та же база, что у платформы: боты пишут привязки и очередь в неё.
DATABASE_URL="postgresql://user:password@localhost:5432/alg?schema=public"

# Прод — 3006 (3001..3005 заняты), локально — 3003.
PORT=3006

# Сообщество ЕДУДА: ключ доступа с правом «Сообщения сообщества».
VK_GROUP_TOKEN=
# Настройки сообщества → Работа с API → Callback API.
VK_CONFIRMATION=
VK_SECRET=

# Заголовок X-Notify-Key для /dispatch — его знает только системный cron.
NOTIFY_KEY=

# MAX — необязательная половина: публикация бота требует верифицированного
# юрлица РФ. Пока токена нет, /max отвечает 503, а VK работает как работал.
MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=https://bots.eduda.online/max
MAX_WEBHOOK_SECRET=
