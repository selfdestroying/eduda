# Та же база, что у платформы: боты пишут привязки и очередь в неё.
DATABASE_URL="postgresql://user:password@localhost:5432/alg?schema=public"

# Прод — 3006 (3001..3005 заняты), локально — 3003.
PORT=3006

# Заголовок X-Notify-Key для /dispatch — его знает только системный cron.
NOTIFY_KEY=

# Адрес платформы — только для ссылки на кабинет родителя в ответах бота.
# Не задан — берётся https://eduda.online.
PLATFORM_URL=https://eduda.online

# Бот MAX. Публикация бота требует верифицированного юрлица РФ, поэтому без
# токена процесс поднимается, но /max отвечает 503 и отправлять нечем.
MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=https://bots.eduda.online/max
MAX_WEBHOOK_SECRET=
